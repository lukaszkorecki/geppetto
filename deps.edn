{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.3"}
        com.stuartsierra/component {:mvn/version "1.2.0"}
        metosin/malli {:mvn/version "0.19.2"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        org.clojure/tools.cli {:mvn/version "1.2.245"}
        babashka/process {:mvn/version "0.6.23"}
        babashka/fs {:mvn/version "0.5.27"}
        com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}

        org.clojars.lukaszkorecki/mokujin-logback {:mvn/version "1.0.0.82"}
        org.clojars.lukaszkorecki/mokujin {:mvn/version "1.0.0.82"}}

 :aliases {:start {:main-opts ["-m" "geppetto.core"]
                   :jvm-opts ["-Dclojure.main.report=stderr"]}
           :test {:extra-paths ["test"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}
                  :main-opts ["-m" "kaocha.runner"]}

           :check {:extra-deps {athos/clj-check {:git/url "https://github.com/athos/clj-check.git"
                                                 :sha "d997df866b2a04b7ce7b17533093ee0a2e2cb729"}}
                   :main-opts ["-m" "clj-check.check"
                               "src"]
                   :jvm-opts ["-Dclojure.main.report=stderr"]}}}
