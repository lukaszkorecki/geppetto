{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        com.stuartsierra/component {:mvn/version "1.2.0"}
        metosin/malli {:mvn/version "0.20.0"}
        clj-commons/clj-yaml {:mvn/version "1.0.29"}
        org.clojure/tools.cli {:mvn/version "1.3.250"}
        babashka/process {:mvn/version "0.6.25"}
        babashka/fs {:mvn/version "0.5.30"}
        com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}

        org.clojars.lukaszkorecki/mokujin-logback {:mvn/version "1.0.0.93"}
        org.clojars.lukaszkorecki/mokujin {:mvn/version "1.0.0.93"}}

 :aliases {:start {:main-opts ["-m" "geppetto.core"]
                   :jvm-opts ["-Dclojure.main.report=stderr"]}
           :test {:extra-paths ["test"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                               lambdaisland/kaocha-cloverage {:mvn/version "1.1.89"}}
                  :main-opts ["-m" "kaocha.runner"]}}}
